# Application Environment
APP_ENV=local
APP_DEBUG=false

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=madong
DB_USERNAME=root
DB_PASSWORD=root
DB_PREFIX=md_

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Queue Redis Configuration
QUEUE_REDIS_HOST=redis://127.0.0.1:6379
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=null
QUEUE_REDIS_DB=0
QUEUE_REDIS_PREFIX=queue

# Cache Configuration
CACHE_CUSTOM_REDIS_HOST=127.0.0.1
CACHE_CUSTOM_REDIS_PORT=6379
CACHE_CUSTOM_REDIS_PASSWORD=null
CACHE_CUSTOM_REDIS_DB=0
CACHE_CUSTOM_REDIS_PREFIX=cache_custom

# JWT Configuration（签名密钥见文件末尾的 JWT_SECRET）
JWT_ALGO=HS256
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800
JWT_LOGIN_MODE=multi

# Feature Toggles
APP_TASK_ENABLED=false
CAPTCHA_ENABLED=false
CAPTCHA_MODE=session
RECYCLE_BIN_ENABLED=true

# Playground 演示环境开关（true=开启拦截，未配置/false=关闭）
PLAYGROUND_ENABLE=false

# Runtime
# 事件循环：留空使用同步模式；仅当已安装 swow 扩展时才启用 Swow 协程驱动
APP_EVENT_LOOP=

# JWT Signing Secret
# 安装向导会自动生成随机密钥并写入 .env；禁止提交真实密钥或使用固定示例值。
# 存量部署升级后执行 `php webman jwt:secret`（加 --force 可强制轮换）。
JWT_SECRET=
